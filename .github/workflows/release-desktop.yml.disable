name: release desktop
jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      packages: write
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup-dagger
      - run: bash .dagger/ci.sh electron
      - name: Checksum and publish Electron artifacts
        env:
          TAG: ${{ inputs.tag || github.ref_name }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          mapfile -t files < <(find webui/rockbox/release -type f \( -name '*.AppImage' -o -name '*.tar.gz' \))
          [ "${#files[@]}" -gt 0 ]
          for file in "${files[@]}"; do sha256sum "$file" > "$file.sha256"; done
          gh release upload "$TAG" "${files[@]}" webui/rockbox/release/*/*.sha256 --clobber
'on':
  push:
    tags:
      - '*'
  workflow_dispatch:
    inputs:
      tag:
        description: The existing tag to publish
        type: string
        required: true
