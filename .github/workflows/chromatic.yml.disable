name: chromatic
jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: ./.github/actions/setup-dagger
      - run: dagger api call -m .dagger/ci storybook --source . export --path .
      - uses: actions/setup-node@v4
        with:
          node-version: 24
      - name: Publish Storybook
        working-directory: webui/rockbox
        env:
          CHROMATIC_PROJECT_TOKEN: ${{ secrets.CHROMATIC_PROJECT_TOKEN }}
        run: npx --yes chromatic --storybook-build-dir storybook-static
'on':
  push:
    branches:
      - master
