name: release
jobs:
  publish:
    strategy:
      matrix:
        os:
          - ubuntu-latest
          - ubuntu-24.04-arm
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
      - uses: ./.github/actions/setup-dagger
      - name: Build SDL release with Dagger
        env:
          TAG: ${{ inputs.tag || github.ref_name }}
          PLATFORM: ${{ runner.arch == 'ARM64' && 'linux/arm64' || 'linux/amd64' }}
        run: dagger api call -m .dagger/ci release --source . --platform "$PLATFORM" --tag "$TAG" export --path .
      - name: Upload release archives
        env:
          TAG: ${{ inputs.tag || github.ref_name }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: gh release upload "$TAG" ./*.tar.gz ./*.tar.gz.sha256 --clobber
    permissions:
      contents: write
'on':
  push:
    tags:
      - '*'
  workflow_dispatch:
    inputs:
      tag:
        description: The existing tag to publish
        type: string
        required: true
