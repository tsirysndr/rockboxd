// Skinnable design tokens. Every visual property in the app reads from this
// global; src/skin.rs overwrites the values at runtime from a skin .toml.
// The defaults below mirror skins/late-night.toml so the slint live-preview
// looks right without the Rust side.

import "../../gpui/assets/fonts/SpaceGrotesk.ttf";
import "../../gpui/assets/fonts/JetBrainsMono.ttf";

export global Theme {
    // Surfaces
    in-out property <color> window-bg: #0c0c0d;
    in-out property <color> panel-bg: #151517;
    in-out property <color> panel-raised: #1d1d21;
    in-out property <color> sidebar-bg: #101012;

    // VFD / LCD display (jetAudio-style readout in the player bar)
    in-out property <color> display-bg: #0a1416;
    in-out property <color> display-glow: #14667440;
    in-out property <color> display-text: #4fd8e0;
    in-out property <color> display-dim: #24565c;

    // Accent
    in-out property <color> accent: #ff8f2b;
    in-out property <color> accent-hover: #ffa952;
    in-out property <color> on-accent: #16110a;

    // Text
    in-out property <color> text: #e8e3da;
    in-out property <color> text-dim: #a09a8e;
    in-out property <color> text-muted: #5f5c55;

    // Lines & states
    in-out property <color> border: #26262b;
    in-out property <color> hover-bg: #ffffff0d;
    in-out property <color> selected-bg: #ff8f2b1a;
    in-out property <color> slider-track: #2a2a30;

    // Level meters (Mixxx-style LED strips)
    in-out property <color> meter-low: #4bb543;
    in-out property <color> meter-mid: #ffb02b;
    in-out property <color> meter-high: #e04b3a;
    in-out property <color> meter-off: #1e1e22;

    // Misc
    in-out property <color> art-placeholder: #222228;
    in-out property <length> radius: 10px;
    in-out property <length> control-radius: 7px;
    in-out property <string> font-ui: "Space Grotesk";
    in-out property <string> font-mono: "JetBrains Mono";
}
