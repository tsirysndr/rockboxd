{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/data.json {:mvn/version "2.5.1"}}

 ;; FFM's restricted native methods require an explicit grant on JDK 25 (else a
 ;; warning is printed on first call and a hard error in a future release).
 :aliases
 {:smoke {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "rockbox.ffi.smoke"]}
  :play  {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "rockbox.ffi.play"]}

  ;; Run an example script: clojure -M:examples examples/<name>.clj [args]
  :examples {:extra-paths ["examples"]
             :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; Build + deploy the jar to Clojars (see build.clj).
  ;;   clojure -T:build jar
  ;;   CLOJARS_USERNAME=<user> CLOJARS_PASSWORD=<deploy-token> clojure -T:build deploy
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}}}
