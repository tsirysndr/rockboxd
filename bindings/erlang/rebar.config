%% rockbox_ffi_nif — shared Erlang NIF for the Rockbox bindings.
%%
%% This package owns the native NIF (c_src/rockbox_ffi_nif.c) and its Erlang
%% loader (src/rockbox_ffi_nif.erl). The Elixir and Gleam bindings depend on it
%% instead of each vendoring their own copy.
%%
%% The multi-megabyte .so is NOT built at consumer compile time and NOT bundled
%% in the Hex tarball (it exceeds Hex's 8 MB limit across platforms). Instead the
%% loader downloads the matching rockbox_ffi_nif-<triple>.so from a GitHub
%% release on first load and verifies it against priv/rockbox_ffi_nif.manifest.
%% For local monorepo development, run `make` to build priv/rockbox_ffi_nif.so.
{erl_opts, [debug_info]}.
{deps, []}.

{project_plugins, [rebar3_hex, rebar3_ex_doc]}.

%% Documentation provider for `rebar3 hex publish` (requires OTP >= 24).
%% Per-function source links must resolve to the monorepo-scoped git tag
%% (erlang-v<vsn>, not the bare v<vsn> ex_doc defaults to) AND to this package's
%% subdirectory (bindings/erlang/), since ex_doc emits paths relative to the
%% rebar3 cwd. source_url_pattern bakes both in — otherwise every link 404s.
{ex_doc, [
  {source_url, <<"https://github.com/tsirysndr/rockboxd">>},
  {source_ref, <<"erlang-v1.2.0">>},
  {source_url_pattern,
   <<"https://github.com/tsirysndr/rockboxd/blob/erlang-v1.2.0/bindings/erlang/%{path}#L%{line}">>},
  {extras, [<<"README.md">>]},
  {main, <<"readme">>}
]}.

%% Files shipped in the Hex tarball. The .so is intentionally excluded (see
%% above); c_src + Makefile are included so a monorepo checkout can build from
%% source, and priv/ carries the checksum manifest.
{hex, [
  {doc, ex_doc},
  {files, [
    "src",
    "c_src",
    "Makefile",
    "priv/rockbox_ffi_nif.manifest",
    "rebar.config",
    "README.md"
  ]}
]}.
