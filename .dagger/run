#!/usr/bin/env bash
# Local convenience wrapper. CI calls ci.sh after mise-action installs the CLI.
set -euo pipefail
cd "$(dirname "$0")/.."
job=${1:-build}
case "$job" in
  image|build_docker|build_cloud)
    mise exec -- dagger api call -m .dagger/ci image --source "${SOURCE:-.}" --tag "${TAG:-latest}" export --path "${OUTPUT:-artifacts/rockbox-image.tar}"
    ;;
  publish)
    : "${IMAGE:?Set IMAGE to a registry/repository:tag and log in with skopeo or Docker first}"
    archive=${ARCHIVE:-artifacts/rockbox-image.tar}
    mise exec -- dagger api call -m .dagger/ci image --source "${SOURCE:-.}" --tag "${TAG:-latest}" export --path "$archive"
    skopeo copy --all "oci-archive:$archive" "docker://$IMAGE"
    ;;
  *) OUTPUT=${OUTPUT:-artifacts} mise exec -- bash .dagger/ci.sh "$job" ;;
esac
